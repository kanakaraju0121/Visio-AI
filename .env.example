# Optional cloud AI integration. Leave blank to disable the Groq feature.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Camera-stream server defaults to localhost (127.0.0.1).
# Set to 0.0.0.0 only when you intentionally need LAN access on a trusted network.
VISIO_HOST=127.0.0.1
VISIO_PORT_HTTPS=8443
VISIO_PORT_HTTP=8080
